{
  "_comment": "SBI AML Pipeline — Ranger Policy Template",
  "_note": "Apply manually via Ranger UI or import via Ranger REST API.",
  "_user": "systest (single account for all components)",
  "policies": [
    {
      "_comment": "Kafka: Topic admin permissions (required for kafka_setup.sh --create)",
      "service": "cm_kafka",
      "name": "aml-kafka-admin",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "topic": {
          "values": ["sbi-aml-transactions", "sbi-aml-alerts"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "create",         "isAllowed": true},
            {"type": "delete",         "isAllowed": true},
            {"type": "configure",      "isAllowed": true},
            {"type": "describe",       "isAllowed": true},
            {"type": "describeConfigs","isAllowed": true},
            {"type": "alterConfigs",   "isAllowed": true}
          ]
        }
      ]
    },
    {
      "_comment": "Kafka: Topic producer permissions (NiFi → Kafka)",
      "service": "cm_kafka",
      "name": "aml-kafka-producer",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "topic": {
          "values": ["sbi-aml-transactions", "sbi-aml-alerts"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "publish",  "isAllowed": true},
            {"type": "describe", "isAllowed": true}
          ]
        }
      ]
    },
    {
      "_comment": "Kafka: Topic consumer permissions (SSB/Flink → Kafka)",
      "service": "cm_kafka",
      "name": "aml-kafka-consumer",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "topic": {
          "values": ["sbi-aml-transactions", "sbi-aml-alerts"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "consume",  "isAllowed": true},
            {"type": "describe", "isAllowed": true}
          ]
        }
      ]
    },
    {
      "_comment": "Kafka: Consumer group permissions",
      "service": "cm_kafka",
      "name": "aml-kafka-consumer-group",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "consumergroup": {
          "values": ["aml-flink", "systest-aml-group"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "consume",  "isAllowed": true},
            {"type": "describe", "isAllowed": true}
          ]
        }
      ]
    },
    {
      "_comment": "Kudu: AML table read/write permissions",
      "service": "cm_kudu",
      "name": "aml-kudu-readwrite",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "table": {
          "values": ["default.aml_transactions", "default.aml_alerts", "default.aml_risk_score"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "read",  "isAllowed": true},
            {"type": "write", "isAllowed": true}
          ]
        }
      ]
    },
    {
      "_comment": "Hive/Impala: AML table access permissions",
      "service": "cm_hive",
      "name": "aml-hive-access",
      "isEnabled": true,
      "isAuditEnabled": true,
      "resources": {
        "database": {
          "values": ["default"],
          "isExcludes": false,
          "isRecursive": false
        },
        "table": {
          "values": ["aml_transactions", "aml_alerts", "aml_risk_score"],
          "isExcludes": false,
          "isRecursive": false
        },
        "column": {
          "values": ["*"],
          "isExcludes": false,
          "isRecursive": false
        }
      },
      "policyItems": [
        {
          "users": ["systest"],
          "groups": [],
          "accesses": [
            {"type": "select", "isAllowed": true},
            {"type": "update", "isAllowed": true},
            {"type": "create", "isAllowed": true},
            {"type": "drop",   "isAllowed": true}
          ]
        }
      ]
    }
  ]
}
